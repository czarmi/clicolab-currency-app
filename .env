NODE_ENV=production
PORT=4100

# National Bank of Poland (NBP) public API - no API key required
NBP_API_BASE_URL=https://api.nbp.pl/api/exchangerates/rates/A

# Redis (cache for NBP responses)
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=1800

# CORS - list of allowed origins that may call this API
# e.g. the main CLICOLAB-DEMO-BANK-APP nginx address
ALLOWED_ORIGIN=http://10.15.0.10
